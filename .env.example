# Copiar a .env.local y completar desde Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Web Push (VAPID) — generada con `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=

# Worker (Railway): limpieza de archivos huerfanos en Storage.
# Por defecto solo informa. Con exactamente "true" borra (tope 200 por corrida).
STORAGE_LIMPIEZA_BORRAR=false
# URL de heartbeat (opcional) de la limpieza semanal de Storage
HEARTBEAT_STORAGE=

# Asistente Chimuelo (Worker)
# SUPABASE_ANON_KEY=eyJ...
# OPENAI_API_KEY=sk-...
# OPENAI_MODELO=gpt-5.6-luna
# OPENAI_PROMPT_ID=pmpt_...
# OPENAI_PROMPT_VERSION=1
# ASISTENTE_TOPE_DIARIO_USD=1
# ASISTENTE_MODELO=openai # 'openai' o 'falso' (tests)
